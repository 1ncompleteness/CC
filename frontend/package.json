{
  "name": "contextcleanse-frontend",
  "version": "0.1.0",
  "description": "Frontend for ContextCleanse",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "build:docker": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:profile": "next build --profile",
    "build:debug": "next build --debug",
    "precompile": "npm run type-check && npm run lint && npm run build",
    "prebuild-pages": "node scripts/prebuild-pages.js",
    "start": "next start",
    "start:production": "NODE_ENV=production next start",
    "lint": "eslint app lib components types proxy.ts",
    "lint:fix": "eslint --fix app lib components types proxy.ts",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "clean": "rm -rf .next out",
    "clean:docker": "rm -rf .next/static .next/server .next/standalone out",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "googleapis": "^176.0.0",
    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
